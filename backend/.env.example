# Copy this file to .env and fill in values. Keep .env out of version control.

# (Optional) Google GenAI API key — used as a fallback by the server
API_KEY=

# Primary / fallback model names
PRIMARY_MODEL=google/gemma-3n-e4b-it
FALLBACK_MODEL=gemini-2.5-flash

# Use external Integrate proxy for PRIMARY_MODEL (true/false)
USE_INTEGRATE=true
# Integrate endpoint and bearer token (the "token" from your test_r2.py)
# In test_r2.py the header used: Authorization: Bearer nvapi-....
# Put that nvapi-... value here (keep secret).
INTEGRATE_URL=https://integrate.api.nvidia.com/v1/chat/completions
INTEGRATE_API_KEY=nvapi-REPLACE_WITH_YOUR_TOKEN

# Cloudflare R2 / S3 settings
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=REPLACE_R2_ACCESS_KEY
R2_SECRET_KEY=REPLACE_R2_SECRET_KEY
R2_BUCKET=signal-newspodcast
R2_PUBLIC_URL=https://<your-r2-bucket-public-host>

# (Optional) CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://news-podcast-app.onrender.com
